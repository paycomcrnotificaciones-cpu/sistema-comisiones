// Estructura de la base de datos del sistema de comisiones.
// Cada "model" es una tabla y cada enum una lista fija de opciones.
// Las relaciones (por ejemplo venta -> comisionista) las controla la base,
// así no quedan registros apuntando a algo que ya no existe.
//
// Regla general: casi todo cuelga de la empresa, porque el sistema puede
// atender varias empresas con los mismos datos separados.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Roles de acceso: el super admin manda en todo, el admin gestiona,
// el supervisor consulta y el comisionista solo ve lo suyo.
enum Rol {
  SUPER_ADMIN
  ADMIN
  SUPERVISOR
  COMISIONISTA
}

// Para qué sirve un enlace de un solo uso.
enum TipoToken {
  INVITACION
  RESETEO
}

// Empresa: el nivel más alto. Todo lo demás le pertenece.
model Empresa {
  id       String   @id @default(uuid())
  nombre   String
  creadoEn DateTime @default(now()) @map("creado_en")

  usuarios              Usuario[]
  sucursales            Sucursal[]
  comisionistas         Comisionista[]
  monedas               Moneda[]
  ventas                Venta[]
  liquidaciones         Liquidacion[]
  suscripciones         Suscripcion[]
  comisionesSuscripcion ComisionSuscripcion[]
  metas                 Meta[]
  auditoria             Auditoria[]
  reglaComisions        ReglaComision[]

  @@map("empresas")
}

// Sucursal: punto de venta. Agrupa comisionistas, ventas y reglas.
model Sucursal {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  nombre    String
  lugar     String?
  creadoEn  DateTime @default(now()) @map("creado_en")

  empresa       Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  comisionistas Comisionista[]
  reglas        ReglaComision[]
  ventas        Venta[]

  @@index([empresaId])
  @@map("sucursales")
}

// Usuario: quien entra al sistema. Puede estar ligado a un comisionista.
model Usuario {
  id             String   @id @default(uuid())
  empresaId      String   @map("empresa_id")
  email          String   @unique
  passwordHash   String   @map("password_hash")
  rol            Rol      @default(COMISIONISTA)
  activo         Boolean  @default(true)
  comisionistaId String?  @unique @map("comisionista_id")
  creadoEn       DateTime @default(now()) @map("creado_en")

  empresa      Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  comisionista Comisionista? @relation(fields: [comisionistaId], references: [id], onDelete: SetNull)
  tokens       TokenAcceso[]

  @@index([empresaId])
  @@map("usuarios")
}

// Enlace de un solo uso para que el usuario cree su propia contraseña.
// Nunca se guarda el token en claro: solo su hash.
model TokenAcceso {
  id        String    @id @default(uuid())
  usuarioId String    @map("usuario_id")
  tokenHash String    @unique @map("token_hash")
  tipo      TipoToken @default(INVITACION)
  expiraEn  DateTime  @map("expira_en")
  usadoEn   DateTime? @map("usado_en")
  creadoEn  DateTime  @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("tokens_acceso")
}

// Comisionista: la persona que vende y gana comisión.
model Comisionista {
  id         String   @id @default(uuid())
  empresaId  String   @map("empresa_id")
  sucursalId String   @map("sucursal_id")
  nombre     String
  activo     Boolean  @default(true)
  creadoEn   DateTime @default(now()) @map("creado_en")

  empresa               Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sucursal              Sucursal              @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  ventas                Venta[]
  usuario               Usuario?
  liquidaciones         Liquidacion[]
  suscripciones         Suscripcion[]
  comisionesSuscripcion ComisionSuscripcion[]
  metas                 Meta[]
  reglaComisions        ReglaComision[]

  @@index([empresaId])
  @@index([sucursalId])
  @@map("comisionistas")
}

// Moneda: catálogo de monedas de la empresa.
model Moneda {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  codigo    String
  nombre    String
  creadoEn  DateTime @default(now()) @map("creado_en")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@map("monedas")
}

// Estado de una venta: activa o anulada (anulada no se borra).
enum EstadoVenta {
  ACTIVA
  ANULADA
}

// La comisión puede ser un porcentaje del neto o un monto fijo.
enum TipoComision {
  PORCENTAJE
  MONTO_FIJO
}

// Una liquidación nace en borrador y pasa a pagada.
enum EstadoLiquidacion {
  BORRADOR
  PAGADA
}

// A qué aplica una regla: a todo, a un producto, a una persona o a una sucursal.
enum AmbitoRegla {
  GLOBAL
  PRODUCTO
  COMISIONISTA
  SUCURSAL
}

// Cómo se le pagó al comisionista.
enum MetodoPago {
  EFECTIVO
  SINPE
  TRANSFERENCIA
  OTRO
}

// Cada cuánto se cobra una suscripción o se paga su comisión.
enum Frecuencia {
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
  UNICA
}

// Una suscripción puede estar activa, en pausa o terminada.
enum EstadoSuscripcion {
  ACTIVA
  PAUSADA
  FINALIZADA
}

// Liquidación: el cierre de un mes para un comisionista.
// Guarda el total a pagar y a qué ventas y comisiones corresponde.
model Liquidacion {
  id             String            @id @default(uuid())
  empresaId      String            @map("empresa_id")
  comisionistaId String            @map("comisionista_id")
  periodo        String
  estado         EstadoLiquidacion @default(BORRADOR)
  comisionTotal  Decimal           @default(0) @map("comision_total") @db.Decimal(18, 4)
  ventasCount    Int               @default(0) @map("ventas_count")
  nota           String?
  metodoPago     MetodoPago?       @map("metodo_pago")
  creadaEn       DateTime          @default(now()) @map("creada_en")
  pagadaEn       DateTime?         @map("pagada_en")

  empresa         Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  comisionista    Comisionista          @relation(fields: [comisionistaId], references: [id], onDelete: Restrict)
  ventas          Venta[]
  comisiones      ComisionSuscripcion[]
  comisionesCount Int                   @default(0) @map("comisiones_count")

  @@unique([empresaId, comisionistaId, periodo])
  @@index([empresaId, periodo])
  @@map("liquidaciones")
}

// Suscripción: cliente que paga cada cierto tiempo y deja comisión recurrente.
model Suscripcion {
  id                 String            @id @default(uuid())
  empresaId          String            @map("empresa_id")
  comisionistaId     String            @map("comisionista_id")
  cliente            String
  producto           String?
  monto              Decimal           @db.Decimal(18, 4)
  frecuenciaCobro    Frecuencia        @map("frecuencia_cobro")
  comisionTipo       TipoComision      @default(PORCENTAJE) @map("comision_tipo")
  comisionValor      Decimal           @map("comision_valor") @db.Decimal(18, 4)
  comisionFrecuencia Frecuencia        @map("comision_frecuencia")
  inicio             DateTime
  fin                DateTime?
  estado             EstadoSuscripcion @default(ACTIVA)
  creadoEn           DateTime          @default(now()) @map("creado_en")

  empresa      Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  comisionista Comisionista          @relation(fields: [comisionistaId], references: [id], onDelete: Restrict)
  comisiones   ComisionSuscripcion[]

  @@index([empresaId, estado])
  @@index([empresaId, comisionistaId])
  @@map("suscripciones")
}

// Comisión generada por una suscripción en un mes concreto.
model ComisionSuscripcion {
  id             String   @id @default(uuid())
  empresaId      String   @map("empresa_id")
  suscripcionId  String   @map("suscripcion_id")
  comisionistaId String   @map("comisionista_id")
  periodo        String
  base           Decimal  @db.Decimal(18, 4)
  monto          Decimal  @db.Decimal(18, 4)
  liquidacionId  String?  @map("liquidacion_id")
  creadoEn       DateTime @default(now()) @map("creado_en")

  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  suscripcion  Suscripcion  @relation(fields: [suscripcionId], references: [id], onDelete: Cascade)
  comisionista Comisionista @relation(fields: [comisionistaId], references: [id], onDelete: Restrict)
  liquidacion  Liquidacion? @relation(fields: [liquidacionId], references: [id], onDelete: SetNull)

  @@unique([suscripcionId, periodo])
  @@index([empresaId, periodo])
  @@index([liquidacionId])
  @@map("comisiones_suscripcion")
}

// Venta: el registro principal. Guarda montos, comisión y si ya se liquidó.
model Venta {
  id             String       @id @default(uuid())
  empresaId      String       @map("empresa_id")
  sucursalId     String       @map("sucursal_id")
  comisionistaId String       @map("comisionista_id")
  fecha          DateTime
  documento      String?
  cliente        String?
  producto       String?
  categoria      String?
  bruto          Decimal      @db.Decimal(18, 4)
  neto           Decimal      @db.Decimal(18, 4)
  costo          Decimal      @default(0) @db.Decimal(18, 4)
  comisionTipo   TipoComision @default(PORCENTAJE) @map("comision_tipo")
  comisionValor  Decimal      @default(0) @map("comision_valor") @db.Decimal(18, 4)
  comisionMonto  Decimal      @default(0) @map("comision_monto") @db.Decimal(18, 4)
  estado         EstadoVenta  @default(ACTIVA)
  liquidacionId  String?      @map("liquidacion_id")
  creadoEn       DateTime     @default(now()) @map("creado_en")

  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sucursal     Sucursal     @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  comisionista Comisionista @relation(fields: [comisionistaId], references: [id], onDelete: Restrict)
  liquidacion  Liquidacion? @relation(fields: [liquidacionId], references: [id], onDelete: SetNull)

  @@unique([empresaId, documento])
  @@index([empresaId, fecha])
  @@index([empresaId, comisionistaId])
  @@index([liquidacionId])
  @@map("ventas")
}

// Meta de venta de un mes, general o de un comisionista.
model Meta {
  id             String   @id @default(uuid())
  empresaId      String   @map("empresa_id")
  comisionistaId String?  @map("comisionista_id")
  periodo        String
  monto          Decimal  @db.Decimal(18, 4)
  creadoEn       DateTime @default(now()) @map("creado_en")
  actualizadoEn  DateTime @updatedAt @map("actualizado_en")

  empresa      Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  comisionista Comisionista? @relation(fields: [comisionistaId], references: [id], onDelete: Cascade)

  @@index([empresaId, periodo])
  @@map("metas")
}

// Auditoría: historial de cambios hechos por los usuarios.
model Auditoria {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  usuarioId String?  @map("usuario_id")
  usuario   String
  rol       String?
  accion    String
  entidad   String?
  entidadId String?  @map("entidad_id")
  metodo    String
  ruta      String
  estado    Int
  creadoEn  DateTime @default(now()) @map("creado_en")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, creadoEn])
  @@map("auditoria")
}

// Regla de comisión: sugerencia para llenar el formulario de venta.
// No cambia liquidaciones ya hechas.
model ReglaComision {
  id             String       @id @default(uuid())
  empresaId      String       @map("empresa_id")
  nombre         String
  activa         Boolean      @default(true)
  tipo           TipoComision
  valor          Decimal      @db.Decimal(18, 4)
  ambito         AmbitoRegla  @default(GLOBAL)
  producto       String?
  comisionistaId String?      @map("comisionista_id")
  sucursalId     String?      @map("sucursal_id")
  prioridad      Int          @default(100)
  acumulable     Boolean      @default(false)
  vigenciaDesde  DateTime?    @map("vigencia_desde")
  vigenciaHasta  DateTime?    @map("vigencia_hasta")
  creadoEn       DateTime     @default(now()) @map("creado_en")
  actualizadoEn  DateTime     @updatedAt @map("actualizado_en")

  empresa      Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  comisionista Comisionista? @relation(fields: [comisionistaId], references: [id], onDelete: Cascade)
  sucursal     Sucursal?     @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@index([empresaId, ambito])
  @@map("reglas_comision")
}
