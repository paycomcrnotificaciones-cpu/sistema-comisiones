# Copia este archivo a .env y ajusta los valores
DATABASE_URL="postgresql://usuario:clave@127.0.0.1:55433/comisiones?schema=public"
PORT=4100
JWT_SECRET="cambia-este-secreto"
WEB_ORIGIN="http://localhost:3100"

# Correo (Gmail): contraseña de aplicación de 16 caracteres, no la del correo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=clave-de-aplicacion
SMTP_FROM=tu-cuenta@gmail.com

# Dirección pública de la web, para armar los enlaces de invitación.
WEB_ORIGIN=http://localhost:3100
# Clave de Brevo para enviar correos por HTTPS (Render bloquea SMTP).
BREVO_API_KEY=
# Relay de correo en Netlify (Render bloquea SMTP).
CORREO_RELAY_URL=
CORREO_RELAY_SECRET=
